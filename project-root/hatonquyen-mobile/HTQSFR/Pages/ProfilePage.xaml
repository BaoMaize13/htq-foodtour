<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HTQSFR.Pages.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F6F6F6, Dark=#121212}">

	<Grid>

		<ScrollView>
			<VerticalStackLayout Padding="20,20,20,90"
                                 Spacing="22">

				<Grid ColumnDefinitions="*,Auto,*">
					<Label x:Name="ProfileTitleLabel"
                           Grid.Column="1"
                           Text="Profile"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                           HorizontalOptions="Center" />
				</Grid>

				<Grid ColumnDefinitions="*,90"
                      ColumnSpacing="14">
					<VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center">
						<Label x:Name="FullNameValueLabel"
                               Text="{Binding FullName}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />

						<Label x:Name="EmailValueLabel"
                               Text="{Binding Email}"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#6B6B6B, Dark=#CFCFCF}" />
					</VerticalStackLayout>

					<Border Grid.Column="1"
                            HeightRequest="80"
                            WidthRequest="80"
                            BackgroundColor="{AppThemeBinding Light=#EAEAEA, Dark=#2A2A2A}"
                            StrokeThickness="0"
                            HorizontalOptions="End">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="40" />
						</Border.StrokeShape>

						<Image Source="{Binding AvatarUrl}"
                               Aspect="AspectFill"
                               HeightRequest="80"
                               WidthRequest="80" />
					</Border>
				</Grid>

				<Grid x:Name="AuthButtonsGrid"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12">
					<Border BackgroundColor="{AppThemeBinding Light=#EEE8E6, Dark=#1E1E1E}"
                            StrokeThickness="0"
                            Padding="0,14"
                            StrokeShape="RoundRectangle 18">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnEditProfileTapped" />
						</Border.GestureRecognizers>

						<Label x:Name="EditLabel"
                               Text="Edit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />
					</Border>

					<Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=#EEE8E6, Dark=#1E1E1E}"
                            StrokeThickness="0"
                            Padding="0,14"
                            StrokeShape="RoundRectangle 18">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnShareProfileTapped" />
						</Border.GestureRecognizers>

						<Label x:Name="ShareProfileLabel"
                               Text="Share Profile"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />
					</Border>
				</Grid>

				<Border x:Name="GuestLoginCard"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=#EEE8E6, Dark=#1E1E1E}"
                        StrokeThickness="0"
                        Padding="16"
                        Margin="0,4,0,0"
                        StrokeShape="RoundRectangle 18">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnGuestLoginTapped" />
					</Border.GestureRecognizers>

					<VerticalStackLayout Spacing="6">
						<Label x:Name="GuestLoginLabel"
                               Text="Login"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

						<Label x:Name="GuestMessageLabel"
                               Text="Login to unlock this feature"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CFCFCF}" />
					</VerticalStackLayout>
				</Border>

				<VerticalStackLayout Spacing="0">

					<Grid ColumnDefinitions="40,*,Auto"
                          Padding="0,12">
						<Border BackgroundColor="#FF6A4A"
                                WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
							<Label Text="☾"
                                   FontSize="18"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
						</Border>

						<Label x:Name="DarkModeLabel"
                               Grid.Column="1"
                               Text="Dark Mode"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                               VerticalTextAlignment="Center"
                               Margin="10,0,0,0" />

						<Switch Grid.Column="2"
                                IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                                OnColor="#FF6A4A"
                                ThumbColor="White"
                                VerticalOptions="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}"
                             Margin="50,0,0,0" />

					<Grid ColumnDefinitions="40,*,Auto"
                          Padding="0,12">
						<Border BackgroundColor="#FF6A4A"
                                WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
							<Label Text="⌖"
                                   FontSize="18"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
						</Border>

						<Label x:Name="LocationServicesLabel"
                               Grid.Column="1"
                               Text="Location Services"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                               VerticalTextAlignment="Center"
                               Margin="10,0,0,0" />

						<Switch Grid.Column="2"
                                IsToggled="{Binding IsLocationServices, Mode=TwoWay}"
                                OnColor="#FF6A4A"
                                ThumbColor="White"
                                VerticalOptions="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}"
                             Margin="50,0,0,0" />

					<Grid ColumnDefinitions="40,*,Auto"
                          Padding="0,12">
						<Border BackgroundColor="#FF6A4A"
                                WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
							<Label Text="◌"
                                   FontSize="18"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
						</Border>

						<Label x:Name="PushNotificationsLabel"
                               Grid.Column="1"
                               Text="Push Notifications"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                               VerticalTextAlignment="Center"
                               Margin="10,0,0,0" />

						<Switch Grid.Column="2"
                                IsToggled="{Binding IsPushNotifications, Mode=TwoWay}"
                                OnColor="#FF6A4A"
                                ThumbColor="White"
                                VerticalOptions="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}"
                             Margin="50,0,0,0" />

					<Grid ColumnDefinitions="40,*,Auto"
                          Padding="0,12">
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnChangeLanguageTapped" />
						</Grid.GestureRecognizers>

						<Border BackgroundColor="#FF6A4A"
                                WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 17"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
							<Label Text="A"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
						</Border>

						<VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             Margin="10,0,0,0"
                                             VerticalOptions="Center">
							<Label x:Name="LanguageLabel"
                                   Text="Language"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

							<Label x:Name="CurrentLanguageLabel"
                                   Text="English"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#CFCFCF}" />
						</VerticalStackLayout>

						<Label Grid.Column="2"
                               Text="›"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#CFCFCF}"
                               VerticalTextAlignment="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}"
                             Margin="50,0,0,0" />
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="0">

					<Grid ColumnDefinitions="*,Auto"
                          Padding="0,14">
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnPrivacyTapped" />
						</Grid.GestureRecognizers>

						<Label x:Name="PrivacyLabel"
                               Text="Privacy"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

						<Label Grid.Column="1"
                               Text="›"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#CFCFCF}"
                               VerticalTextAlignment="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}" />

					<Grid ColumnDefinitions="*,Auto"
                          Padding="0,14">
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnHelpTapped" />
						</Grid.GestureRecognizers>

						<Label x:Name="HelpLabel"
                               Text="Help"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

						<Label Grid.Column="1"
                               Text="›"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#CFCFCF}"
                               VerticalTextAlignment="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}" />

					<Grid x:Name="LogoutRow"
                          ColumnDefinitions="*,Auto"
                          Padding="0,14">
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnLogoutTapped" />
						</Grid.GestureRecognizers>

						<Label x:Name="LogoutLabel"
                               Text="Logout"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

						<Label Grid.Column="1"
                               Text="›"
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#CFCFCF}"
                               VerticalTextAlignment="Center" />
					</Grid>

					<BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E7E1DE, Dark=#2E2E2E}" />
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>

		<Grid x:Name="EditProfileOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="100">

			<Grid.GestureRecognizers>
				<TapGestureRecognizer Tapped="OnEditOverlayBackgroundTapped" />
			</Grid.GestureRecognizers>

			<Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="360">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="24" />
				</Border.StrokeShape>

				<VerticalStackLayout Spacing="16">

					<Label x:Name="EditProfileTitleLabel"
                           Text="Edit profile"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                           HorizontalTextAlignment="Center" />

					<VerticalStackLayout Spacing="8">
						<Label x:Name="EditFullNameLabel"
                               Text="Full name"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#444444, Dark=#DDDDDD}" />

						<Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                Padding="14,10">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="14" />
							</Border.StrokeShape>

							<Entry x:Name="EditFullNameEntry"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                   Placeholder="Full name"
                                   PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout Spacing="8">
						<Label x:Name="EditEmailLabel"
                               Text="Email"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#444444, Dark=#DDDDDD}" />

						<Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                Padding="14,10">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="14" />
							</Border.StrokeShape>

							<Entry x:Name="EditEmailEntry"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}"
                                   Placeholder="Email"
                                   PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"
                                   Keyboard="Email" />
						</Border>
					</VerticalStackLayout>

					<Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12"
                          Margin="0,8,0,0">

						<Border BackgroundColor="{AppThemeBinding Light=#EEE8E6, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                Padding="0,14"
                                StrokeShape="RoundRectangle 16">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnCloseEditProfilePopupTapped" />
							</Border.GestureRecognizers>

							<Label x:Name="EditCancelLabel"
                                   Text="Cancel"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#444444, Dark=White}" />
						</Border>

						<Border Grid.Column="1"
                                BackgroundColor="#FF6A4A"
                                StrokeThickness="0"
                                Padding="0,14"
                                StrokeShape="RoundRectangle 16">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnSaveEditProfileTapped" />
							</Border.GestureRecognizers>

							<Label x:Name="EditSaveLabel"
                                   Text="Save"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White" />
						</Border>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</Grid>

	</Grid>
</ContentPage>